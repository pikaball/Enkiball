      "    merged_before_verification: merged.length,\n",
      "    rejected: rejectedIds.length,\n",
      "    verified_accepted: accepted.length,\n",
      "    coverage_new: coverageNew.length,\n",
      "    final_ledger: finalLedger.length\n",
      "  },\n",
      "  summaries: {\n",
      "    file_layer: phase1.filter(Boolean).map((r) => r.summary),\n",
      "    cross_layer: phase2.filter(Boolean).map((r) => r.summary),\n",
      "    verification: verifier ? verifier.summary : '(verifier failed)',\n",
      "    coverage: coverage ? coverage.summary : '(coverage pass failed)'\n",
      "  },\n",
      "  rejected_ids: rejectedIds,\n",
      "  ledger: finalLedger\n",
      "};\n"
     ]
