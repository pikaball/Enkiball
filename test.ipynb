      "const f2 = [];\n",
      "phase2.forEach((res, i) => {\n",
      "  if (!res || !Array.isArray(res.findings)) return;\n",
      "  res.findings.forEach((f, j) => f2.push({ ...f, id: 'f2-' + i + '-' + j }));\n",
      "});\n",
      "\n",
      "const merged = f1.concat(f2);\n",
      "log('Merged findings before verification: ' + merged.length);\n",
      "\n",
      "phase('验证层');\n",
      "const verification = await parallel([\n",
      "  () => agent(verifyPrompt(merged), { schema: VERIFY_SCHEMA, label: '对抗性验证', phase: '验证层' }),\n",
      "  () => agent(coveragePrompt(merged), { schema: FINDING_SCHEMA, label: '覆盖检查', phase: '验证层' })\n",
