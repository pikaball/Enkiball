      "\n",
      "const verifier = verification[0];\n",
      "const coverage = verification[1];\n",
      "\n",
      "const rejectedIds = verifier && Array.isArray(verifier.rejected_ids) ? verifier.rejected_ids : [];\n",
      "const accepted = verifier && Array.isArray(verifier.accepted) ? verifier.accepted : [];\n",
      "const coverageNew = coverage && Array.isArray(coverage.findings)\n",
      "  ? coverage.findings.map((f, j) => ({ ...f, id: 'cov-' + j }))\n",
      "  : [];\n",
      "\n",
      "const severityOrder = { critical: 0, high: 1, medium: 2, low: 3, info: 4 };\n",
      "const finalLedger = accepted.concat(coverageNew).sort((a, b) =>\n",
      "  (severityOrder[a.severity] ?? 9) - (severityOrder[b.severity] ?? 9) ||\n",
      "  (a.file + ':' + a.location).localeCompare(b.file + ':' + b.location)\n",
      ");\n",
      "\n",
      "return {\n",
      "  counts: {\n",
